# Guide API base URL (no trailing slash, no /api/guide).
# Used by the Guide tab to call your spiritual-app/server.

# Web or iOS simulator (default if unset):
# EXPO_PUBLIC_GUIDE_API_URL=http://localhost:3001

# Physical phone: use your computer's LAN IP so the phone can reach the server.
# Find it: run "ipconfig" (Windows) and use the IPv4 Address of Wi-Fi or Ethernet.
# Example (replace with your IP from ipconfig):
# EXPO_PUBLIC_GUIDE_API_URL=http://192.168.1.5:3001
