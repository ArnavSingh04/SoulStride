# Spiritual Guide API (Vertex AI)
# Copy to .env and set as needed. ADC is used if these are unset.

PORT=3001
GOOGLE_CLOUD_PROJECT=project-45e7f38c-dbb5-44ae-beb
GOOGLE_CLOUD_LOCATION=us-central1
# Use a valid Vertex model ID (e.g. gemini-2.0-flash or gemini-2.5-flash). Do NOT use "gemini-1.5-flash" (404).
GEMINI_MODEL=gemini-2.0-flash
